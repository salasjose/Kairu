/**
 * @fileoverview Firestore Security Rules for EcoQuest Explorers.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user has full control over their own data tree,
 * and no user can access another user's data.
 *
 * Data Structure:
 * All data is nested under /users/{userId}, ensuring clear ownership.  Subcollections track user progress and
 * submissions. The data model is designed for authorization independence; all subcollections include the userId.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Anonymous authentication is supported.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    /**
     * @returns {boolean} True if the user is signed in (authenticated).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @param {string} userId - The UID of the resource owner.
     * @returns {boolean} True if the requesting user is the owner of the document.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Path Rules ---

    /**
     * @description Enforces access control for user profiles. A user can only access their own profile.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn(); // A user can create their own document upon signup.

      /**
       * @description Enforces access control for all subcollections under a user's document.
       * The `isOwner(userId)` check ensures that a user can only access data within their own user tree.
       * This single rule covers all nested challenge submissions and progress tracking collections.
       *
       * @path /users/{userId}/{subcollection}/{docId}
       */
      match /{subcollection}/{docId} {
         allow read, write: if isOwner(userId);
      }
    }
  }
}
