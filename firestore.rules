/**
 * @fileoverview Firestore Security Rules for EcoQuest Explorers.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles, station progress, and content submissions.
 * Each user can only create, read, update, and delete their own data.
 * Stations data are public read-only.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 * - /stations/{stationId}: Stores information about game stations (publicly readable).
 * - /users/{userId}/stationProgress/{stationProgressId}: Stores user's progress for each station.
 * - /users/{userId}/stationProgress/{stationProgressId}/contentSubmissions/{contentSubmissionId}: Stores user's content submissions for each station.
 *
 * Key Security Decisions:
 * - Users can only manage their own profile and associated data.
 * - Stations are publicly readable but not writable through the client.
 * - Listing of users is not permitted.
 *
 * Denormalization for Authorization:
 * - The `userId` is present in both the path and the `StationProgress` and `ContentSubmission` documents, enabling efficient ownership checks without extra reads.
 *
 * Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, ensuring only the owning user can access it. Public station data is stored in the top-level `/stations/{stationId}` collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information. Only the user can read, update, or delete their own profile.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (create) User 'user_abc' can create their profile if request.auth.uid == userId.
     * @allow (get) User 'user_abc' can read their profile.
     * @allow (update) User 'user_abc' can update their profile.
     * @allow (delete) User 'user_abc' can delete their profile.
     * @deny (create) User 'user_xyz' cannot create a profile with userId 'user_abc'.
     * @deny (get) User 'user_xyz' cannot read user 'user_abc' profile.
     * @deny (update) User 'user_xyz' cannot update user 'user_abc' profile.
     * @deny (delete) User 'user_xyz' cannot delete user 'user_abc' profile.
     * @principle Enforces document ownership for writes.  Validates the 'id' field on create and enforces immutability on update to prevent unauthorized changes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to station information. Stations are publicly readable, but only server can create, update, or delete them.
     * @path /databases/{database}/documents/stations/{stationId}
     * @allow (get) Any user can read station information.
     * @allow (list) Any user can list stations.
     * @deny (create) No client can create station documents.
     * @deny (update) No client can update station documents.
     * @deny (delete) No client can delete station documents.
     * @principle Stations are read-only for users, with server-side management.
     */
    match /stations/{stationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to user's station progress. Only the user can create, read, update, or delete their own progress.
     * @path /databases/{database}/documents/users/{userId}/stationProgress/{stationProgressId}
     * @allow (create) User 'user_abc' can create station progress if request.auth.uid == userId.
     * @allow (get) User 'user_abc' can read their station progress.
     * @allow (update) User 'user_abc' can update their station progress.
     * @allow (delete) User 'user_abc' can delete their station progress.
     * @deny (create) User 'user_xyz' cannot create station progress for user 'user_abc'.
     * @deny (get) User 'user_xyz' cannot read user 'user_abc' station progress.
     * @deny (update) User 'user_xyz' cannot update user 'user_abc' station progress.
     * @deny (delete) User 'user_xyz' cannot delete user 'user_abc' station progress.
     * @principle Enforces document ownership for writes. Validates the 'userId' field on create and enforces immutability on update to prevent unauthorized changes.
     */
    match /users/{userId}/stationProgress/{stationProgressId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to user's content submissions for a station. Only the user can create, read, update, or delete their own submissions.
     * @path /databases/{database}/documents/users/{userId}/stationProgress/{stationProgressId}/contentSubmissions/{contentSubmissionId}
     * @allow (create) User 'user_abc' can create content submission if request.auth.uid == userId.
     * @allow (get) User 'user_abc' can read their content submission.
     * @allow (update) User 'user_abc' can update their content submission.
     * @allow (delete) User 'user_abc' can delete their content submission.
     * @deny (create) User 'user_xyz' cannot create content submission for user 'user_abc'.
     * @deny (get) User 'user_xyz' cannot read user 'user_abc' content submission.
     * @deny (update) User 'user_xyz' cannot update user 'user_abc' content submission.
     * @deny (delete) User 'user_xyz' cannot delete user 'user_abc' content submission.
     * @principle Enforces document ownership for writes. Validates the 'userId' field on create and enforces immutability on update to prevent unauthorized changes.
     */
    match /users/{userId}/stationProgress/{stationProgressId}/contentSubmissions/{contentSubmissionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}